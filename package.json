{
  "name": "pre-recorded-live-manifest-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:gated": "prep/dev-gated.sh",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "build:worker-bundle": "node scripts/bundle-worker.mjs",
    "build:shaka-venv": "bash scripts/bundle-shaka-venv.sh",
    "build:desktop-resources": "bash scripts/bundle-desktop-resources.sh",
    "generate:app-icon": "python3 scripts/generate-app-icon.py && pnpm --dir desktop tauri icon src-tauri/icons/app-icon-source.png -o src-tauri/icons && cp desktop/src-tauri/icons/128x128.png desktop/src/assets/playout-icon.png && touch desktop/src-tauri/build.rs",
    "test:license": "pnpm --dir license-worker test",
    "test:license:integration": "pnpm --dir license-worker test:integration",
    "dev:license": "pnpm --dir license-worker dev",
    "desktop:dev": "pnpm --dir desktop tauri dev",
    "desktop:build": "pnpm build:worker-bundle && pnpm build:desktop-resources && pnpm --dir desktop tauri build --config src-tauri/tauri.release.conf.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
